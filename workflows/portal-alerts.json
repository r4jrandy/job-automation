    {
      "parameters": {
        "jsCode": "const profile = `Target roles: Senior Automation Engineer, QA Automation Engineer, SDET, Senior SDET, Test Automation Engineer, Automation Lead, QA Lead\nMust-have: JavaScript/TypeScript, UI automation, API testing. Strong preference: Playwright\nExperience: 7 years (open to roles asking 5 to 10 years)\nLocations: Hyderabad, Remote (India)\nExclude: internship, fresher, trainee, manual testing only, 12+ years`;\n\nconst toText = html => (html || '')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<a\\b[^>]*href=[\"']([^\"']+)[\"'][^>]*>([\\s\\S]*?)<\\/a>/gi, ' $2 [LINK: $1] ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&amp;/g, '&').replace(/&nbsp;/g, ' ')\n  .replace(/\\s+/g, ' ').trim();\n\nconst out = [];\nfor (const item of $input.all()) {\n  const e = item.json;\n  if (!e.subject && !e.html && !e.text) continue;\n  const from = JSON.stringify(e.from || '').toLowerCase();\n  const source = from.includes('linkedin') ? 'LinkedIn'\n    : from.includes('naukri') ? 'Naukri'\n    : from.includes('indeed') ? 'Indeed'\n    : from.includes('foundit') || from.includes('monster') ? 'Foundit'\n    : 'Alert';\n  const body = toText(e.html || e.textAsHtml || e.text).slice(0, 30000);\n  const prompt = `This is a job alert email from ${source}. Extract every job listing in it.\n\nCANDIDATE PROFILE:\n${profile}\n\nFor each job give: title, company, location, link (the [LINK: ...] URL next to that job's title), score, reason.\nRules:\n- Score 0-100 using only the title, company and location. Be strict about seniority and role type.\n- Skip jobs that are not related to QA, testing, SDET or automation.\n- Only use links that appear in the email. Never invent data.\n- reason: max 15 words.\nReturn JSON only: {\"jobs\":[{\"title\":\"\",\"company\":\"\",\"location\":\"\",\"link\":\"\",\"score\":0,\"reason\":\"\"}]}\n\nEMAIL SUBJECT: ${e.subject || ''}\nEMAIL TEXT: ${body}`;\n  out.push({ json: {\n    source,\n    geminiBody: {\n      contents: [{ parts: [{ text: prompt }] }],\n      generationConfig: { responseMimeType: 'application/json', temperature: 0.1 }\n    }\n  }});\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        48,
        272
      ],
      "id": "b809a04c-77b2-426c-9bb5-db7dce9c7d28",
