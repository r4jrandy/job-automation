      "id": "448c6f38-dd06-492e-a825-0ab7753c0991",
      "name": "Gemini Extract",
      "credentials": {
        "httpHeaderAuth": {
          "id": "f5HpMIXeJnRBtrLV",
          "name": "Gemini Key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const norm = s => String(s || '').toLowerCase().replace(/[^a-z0-9]/g, '');\nconst cleanLink = (l, src) => {\n  l = String(l || '').trim();\n  return src === 'LinkedIn' ? l.split('?')[0] : l;\n};\n\nlet existing = [];\ntry { existing = $('Get existing jobs').all().map(i => i.json); } catch (e) {}\nconst seenLinks = new Set(existing.map(j => String(j.Link || '').trim()).filter(Boolean));\nconst seenKeys = new Set(existing.map(j => norm(j.Company) + '|' + norm(j.Role)));\n\nconst out = [];\n$input.all().forEach((item, i) => {\n  const src = $('Build Prompt').itemMatching(i).json.source;\n  let jobs = [];\n  try {\n    const txt = item.json.candidates[0].content.parts[0].text;\n    jobs = JSON.parse(txt.replace(/```json|```/g, '').trim()).jobs || [];\n  } catch (e) { return; }\n\n  for (const j of jobs) {\n    const link = cleanLink(j.link, src);\n    const key = norm(j.company) + '|' + norm(j.title);\n    if (!link || !j.title) continue;\n    if (Number(j.score) < 60) continue;\n    if (seenLinks.has(link) || seenKeys.has(key)) continue;\n    seenLinks.add(link); seenKeys.add(key);\n    out.push({ json: {\n      'Date': new Date().toISOString().slice(0, 10),\n      'Company': j.company || '',\n      'Role': j.title,\n      'Link': link,\n      'Source': src + ' alert',\n      'Score': Number(j.score) || 0,\n      'Reason': (j.reason || '') + ' (title-based score, check the full JD)',\n      'Tailored Notes': '',\n      'Contact Email': '',\n      'Status': 'New',\n      'Follow-up Date': ''\n    }});\n  }\n});\nreturn out;"
      },
